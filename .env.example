# ---- Uygulama (Vite) için gerekli ----
VITE_SUPABASE_URL=https://proje.supabase.co
VITE_SUPABASE_ANON_KEY=anon-key-buraya

# ---- Yalnızca "npm run db:push" komutu için gerekli ----
# Supabase > Account Preferences > Personal Access Token > Generate New Token
# Bu değerler sunucuya hiç gönderilmez, sadece terminalden Supabase API'sine bağlanmak için kullanılır.
SUPABASE_ACCESS_TOKEN=sbp_token-buraya
SUPABASE_PROJECT_REF=proje-referansi
